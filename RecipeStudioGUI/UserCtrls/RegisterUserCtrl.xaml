<UserControl x:Class="RecipeStudioUI.UserCtrls.RegisterUserCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecipeStudioUI.UserCtrls"      
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:RecipeStudioUI.ViewModels" 
             xmlns:conv="clr-namespace:RecipeStudioUI.Converters"
             d:DataContext="{d:DesignInstance Type=vm:RegisterVMDesigner}"
             d:DesignHeight="450" d:DesignWidth="800">
 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          
           
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="Auto"/>
          
        </Grid.ColumnDefinitions>

        <!-- Username -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtUsername" 
                 Width="200" Margin="5" HorizontalAlignment="Left" 
                 Text="{Binding Username,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

        <!--<TextBlock Grid.Row="0" Grid.Column="2"   Text="{Binding LogInfo}" 
                   VerticalAlignment="Center" Margin="5" />-->


        <!-- Email -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmail" Width="200" Margin="5" 
                 HorizontalAlignment="Left" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Password -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="pwdBox" Width="200" Margin="5" 
                     HorizontalAlignment="Left" MaxLength="6"   
                     PasswordChanged="pwdBox_PasswordChanged"                   
                    />

        <!-- Register Button -->
        <Button Grid.Row="3" Grid.Column="1" Content="Register" Width="100" Margin="5"
                HorizontalAlignment="Right" Command="{Binding RegisterCmd}"
             
                 />



    </Grid>
</UserControl>
