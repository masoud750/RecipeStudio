<UserControl x:Class="RecipeStudioUI.UserCtrls.ComboBoxEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecipeStudioUI.UserCtrls"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="600">
    <Grid>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ComboBox -->
            <ComboBox Grid.Column="0"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Margin="5"/>

            <!-- Add Button -->
            <Button Grid.Column="1" Content="Add" Width="60" Margin="5"
                Command="{Binding AddItemCommand}"/>

            <!-- Delete Button -->
            <Button Grid.Column="2" Content="Delete" Width="60" Margin="5"
                Command="{Binding DeleteItemCommand}"/>
        </Grid>

    </Grid>
</UserControl>
