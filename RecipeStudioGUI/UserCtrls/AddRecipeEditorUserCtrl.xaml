<UserControl x:Class="RecipeStudioUI.UserCtrls.AddRecipeEditorUserCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecipeStudioUI.UserCtrls"
            
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="600">
    <Grid >
        <Grid.RowDefinitions >
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="10"
                   Text="Categorys:" HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                  
                   ></TextBlock>


     

        <local:AddItemEditor Grid.Row="0" Grid.Column="1"  DataContext="{Binding CategoryChooser}"></local:AddItemEditor>
        <!-- Row  -->
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="10"
            Text="Ingredients:" HorizontalAlignment="Left"
            VerticalAlignment="Center"></TextBlock>

        <local:AddItemEditor  Grid.Row="1" Grid.Column="1" DataContext="{Binding IngredientChooser}"></local:AddItemEditor>

        <!-- Row  -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="10"
    Text="Instructions:" HorizontalAlignment="Left"
    VerticalAlignment="Center"></TextBlock>

        <local:AddItemEditor Grid.Row="2" Grid.Column="1" DataContext="{Binding StepChooser}"></local:AddItemEditor>

        <!-- Row -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Margin="10"></TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="10" Text="{Binding Description}"></TextBox>
        <!-- Row -->
        <TextBlock  Grid.Row="4" Grid.Column="0" Margin="10" Text="Name:"></TextBlock>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="10" Text="{Binding RecipeName, 
            UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ></TextBox>
        <!-- Row -->
        <Separator Grid.Row="5" Margin="10" Grid.ColumnSpan="2"> </Separator>

        <!-- Row -->
        <DockPanel Grid.Row="6" Grid.ColumnSpan="3" Background="AliceBlue"
                   LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Add" Width="80" Height="30"
                    Margin="10"   Command="{Binding   AddRecipeCmd}"/>
        
                  
        </DockPanel>

    </Grid>
</UserControl>
