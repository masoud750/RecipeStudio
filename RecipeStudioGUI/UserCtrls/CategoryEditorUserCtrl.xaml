<UserControl x:Class="RecipeStudio.UI.UserCtrls.CategoryEditorUserCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecipeStudio.UI.UserCtrls"
             mc:Ignorable="d" 
             xmlns:conv="clr-namespace:RecipeStudio.UI.Converters"
             d:DesignHeight="150" d:DesignWidth="600">

    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"
                           TrueBrush="Red"
                           FalseBrush="Black"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Linke Seite -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Available Categories" Margin="5">
                <ListView ItemsSource="{Binding AvailableCategories}" >
                    <ListView.View>
                        <GridView>
                            <!-- Column 1: CheckBox -->
                            <GridViewColumn Header="Select" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"  />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 2: Category Name -->
                            <GridViewColumn Header="Category" Width="150"
                                    DisplayMemberBinding="{Binding Name}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="5">
                <Button Content="Clear" Width="75" Margin="5" 
                        Command="{Binding ClearCmd}"/>
                <Button Content="Select All" Width="75" Margin="5" 
                        Command="{Binding SelectAllCmd}" />
            </StackPanel>
        </Grid>

        <!-- Rechte Seite -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Selected Categories" Margin="5">
                <ListView ItemsSource="{Binding SelectedCategories}">
                    <ListView.View>
                        <GridView>
                            <!-- Column 2: Category Name -->
                            <GridViewColumn Header="Category" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                       Foreground="{Binding IsExpired, Converter={StaticResource BoolToBrushConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="5">
                <Button Content="Remove" Width="75" Margin="5" 
                        Command="{Binding RemoveDeltedCategoriesFromRecipeCmd}"/>
                <Button Content="Save" Width="75" Margin="5" Command="{Binding SaveCmd}"  />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
